{
  "name": "@chatiapp/client",
  "version": "0.1.0",
  "description": "Cliente oficial de TypeScript para la API de ChatIApp, con streaming SSE tipado.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=18" },
  "repository": { "type": "git", "url": "https://github.com/jmmana/ChatIApp", "directory": "sdks/typescript" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
