# =============================================================================
# ChatIApp · Variables de entorno
#
# Copia este archivo a .env (nunca lo subas al repositorio) y completa lo que
# uses. docker compose lo lee solo; con docker run, pásalo con --env-file .env.
# Ninguna variable es obligatoria para arrancar la demo, salvo una API key de
# IA (o Ollama) para poder preguntar.
# =============================================================================

# --- Base de datos de la app -------------------------------------------------
# Por defecto, SQLite en el volumen /data (docs/adr/0008-imagen-unica-con-sqlite.md).
# CHATIAPP_DATABASE_URL=sqlite:////data/chatiapp.db
# Con el perfil `postgres` de docker compose (o una base PostgreSQL tuya):
# CHATIAPP_DATABASE_URL=postgresql+psycopg://chatiapp:cambia-esto@postgres:5432/chatiapp
# CHATIAPP_DB_PASSWORD=cambia-esto

# --- Cifrado de credenciales -------------------------------------------------
# Si no la defines, la imagen genera una en /data/secret.key la primera vez.
# En producción, defínela desde tu gestor de secretos. Para generar una:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# CHATIAPP_SECRET_KEY=
# Llave anterior, solo mientras rotas (docs/PROVEEDORES_IA.md#credenciales).
# CHATIAPP_SECRET_KEY_PREVIOUS=

# --- Configuración como código -----------------------------------------------
# Archivo chatiapp.yaml dentro del contenedor. docker compose monta
# CHATIAPP_CONFIG_DIR (por defecto ./examples) en /config.
# CHATIAPP_CONFIG=/config/chatiapp.example.yaml
# CHATIAPP_CONFIG_DIR=./examples

# --- Proveedores de IA (usa los que declares en chatiapp.yaml) ---------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# BEDROCK_MODEL_ID=
# Con el perfil `local-ai` de docker compose:
# OLLAMA_API_BASE=http://ollama:11434

# --- Bases de datos que se consultan (usuario de SOLO LECTURA) ---------------
# VENTAS_DB_URL=postgresql+psycopg://lector:cambia-esto@db.ejemplo.com:5432/ventas

# --- Contenedor --------------------------------------------------------------
# Puerto en tu máquina (docker compose).
# CHATIAPP_PORT=8080
# false = no generar la base de demostración en /data/demo/ventas.db.
# CHATIAPP_DEMO=true
# development | production (la imagen usa production).
# CHATIAPP_ENV=production
